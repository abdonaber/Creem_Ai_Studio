# GEMINI_API_KEY: Optional AI assistant / smart routing optimization key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV=development

# Database (MongoDB connection URI - e.g. mongodb+srv://... or local)
MONGODB_URI=""

# Security & Authentication Secrets
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Payment Gateway (Optional - falls back to Test/Sandbox provider if not provided)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Operational modes
DEMO_MODE=true
ENABLE_SIMULATION=true
CORS_ORIGIN=""
