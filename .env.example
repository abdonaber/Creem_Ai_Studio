# ==============================================================================
# CreemY Production Platform Environment Configuration
# ==============================================================================

# Application Environment (development | test | production)
APP_ENV=development
APP_MODE=production
NODE_ENV=development

# Server Binding
PORT=3000
APP_URL=http://localhost:3000

# MongoDB Database Connection (MongoDB Atlas or standalone cluster)
# Format: mongodb+srv://<user>:<password>@cluster0.mongodb.net/creemy?retryWrites=true&w=majority
MONGODB_URI=

# Redis Connection (For distributed locks, dispatch queues, and socket scaling)
# Format: redis://:password@host:6379/0 or rediss://...
REDIS_URL=

# Cryptographic Keys (Must be minimum 32 random characters in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins in production
# e.g. https://creemy.app,https://admin.creemy.app
CORS_ALLOWED_ORIGINS=

# Optional Routing Providers (Google Maps / Mapbox)
# If provided, live navigation polylines and geocoding will use these providers
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Optional Google Gemini AI Key (for routing intelligence and route descriptions)
GEMINI_API_KEY=
