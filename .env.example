# ==============================================================================
# Creem Production Platform Environment Configuration
# ==============================================================================

# Application Environment (development | test | production)
# Must agree in production (do not mix production with development)
APP_ENV=development
APP_MODE=development
NODE_ENV=development

# Server Binding
PORT=3000
APP_URL=http://localhost:3000

# MongoDB Database Connection (MongoDB Atlas or Replica Set required in production)
# Format: mongodb+srv://<user>:<password>@cluster0.mongodb.net/creem?retryWrites=true&w=majority
MONGODB_URI=

# Redis Connection (Required in production for locks, BullMQ queues, and Socket.IO scaling)
# Format: redis://:password@host:6379/0 or rediss://...
REDIS_URL=

# Cryptographic Keys (Minimum 32 random characters required in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Optional Metrics Protection Token (recommended in production for /metrics scraping)
METRICS_AUTH_TOKEN=

# Stripe Payment Gateway (Required in production)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cross-Origin Resource Sharing (CORS)
# Required in production: comma-separated exact origins (wildcard '*' is forbidden)
# Example: https://creem.app,https://admin.creem.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Platform Commission Rate (default 0.20 = 20%)
PLATFORM_COMMISSION_RATE=0.2

# Optional Routing Providers (Google Maps / Mapbox)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
ROUTING_PROVIDER=auto

# Driver Location Freshness Threshold (milliseconds, default 60000 = 60s)
DRIVER_LOCATION_STALE_MS=60000

# Optional Server-Side Gemini AI Key
GEMINI_API_KEY=
